--// =========================================
--// MOVIMIENTO DEL MENÚ
--// =========================================

UserInputService.InputChanged:Connect(function(input)

    if not draggingMain then

        return

    end


    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - dragStartMain


        Main.Position = UDim2.new(

            startPositionMain.X.Scale,

            startPositionMain.X.Offset + delta.X,

            startPositionMain.Y.Scale,

            startPositionMain.Y.Offset + delta.Y

        )


        --// GUARDAR POSICIÓN DEL MENÚ

        savedMainPosition = Main.Position

    end

end)


--// =========================================
--// DRAG DEL OJO
--// =========================================

local draggingOpen = false

local dragStartOpen

local startPositionOpen

local openMoved = false


OpenButton.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        draggingOpen = true

        openMoved = false

        dragStartOpen = input.Position

        startPositionOpen = OpenButton.Position

    end

end)


OpenButton.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        draggingOpen = false

    end

end)


UserInputService.InputChanged:Connect(function(input)

    if not draggingOpen then

        return

    end


    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - dragStartOpen


        --// Detectar movimiento real

        if math.abs(delta.X) > 5
            or math.abs(delta.Y) > 5 then

            openMoved = true

            openHasBeenMoved = true

        end


        OpenButton.Position = UDim2.new(

            startPositionOpen.X.Scale,

            startPositionOpen.X.Offset + delta.X,

            startPositionOpen.Y.Scale,

            startPositionOpen.Y.Offset + delta.Y

        )


        --// =====================================
        --// GUARDAR POSICIÓN DEL OJO
        --// =====================================

        savedOpenPosition = OpenButton.Position

    end

end)


--// =========================================
--// MINIMIZAR
--// =========================================

Minimize.MouseButton1Click:Connect(function()

    if minimized then

        return

    end


    minimized = true


    --// =====================================
    --// GUARDAR POSICIÓN DEL MENÚ
    --// =====================================

    savedMainPosition = Main.Position


    --// =====================================
    --// PRIMERA VEZ
    --// =====================================
    --
    --// Si nunca moviste el ojo, aparece
    --// centrado sobre el menú.
    --
    --// Después de moverlo, SIEMPRE conserva
    --// su propia posición.
    --

    if not openHasBeenMoved then

        savedOpenPosition = UDim2.new(

            savedMainPosition.X.Scale,

            savedMainPosition.X.Offset + 131,

            savedMainPosition.Y.Scale,

            savedMainPosition.Y.Offset + 171

        )

    end


    --// Colocar el ojo en su posición guardada

    OpenButton.Position = savedOpenPosition


    Main.Visible = false

    OpenButton.Visible = true

end)


--// =========================================
--// ABRIR DESDE EL OJO
--// =========================================

OpenButton.MouseButton1Click:Connect(function()

    --// Si acabamos de arrastrarlo,
    --// no abrir accidentalmente.

    if openMoved then

        openMoved = false

        return

    end


    minimized = false


    --// Guardar su posición actual

    savedOpenPosition = OpenButton.Position


    --// Restaurar el menú donde estaba

    Main.Position = savedMainPosition


    Main.Visible = true

    OpenButton.Visible = false

end)


