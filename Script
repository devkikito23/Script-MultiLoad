local scripts = {
    "https://rawscripts.net/raw/Universal-Script-PlayerTools-239952",
    "https://rawscripts.net/raw/Natural-Disaster-Survival-super-ring-parts-open-source-NO-TEXT-CHAT-MESSAGE-212258",
    "https://rawscripts.net/raw/Universal-Script-inf-health-102308",
    -- Agrega más aquí:
    -- "https://rawscripts.net/raw/otro-script",
}

local function loadScript(url)
    local success, result = pcall(function()
        return game:HttpGet(url)
    end)

    if success and result and result ~= "" then
        local loadSuccess, err = pcall(function()
            loadstring(result)()
        end)
        
        if loadSuccess then
            print("[+] Cargado:", url)
        else
            warn("[-] Error al ejecutar:", url, err)
        end
    else
        warn("[-] Error al descargar:", url)
    end
end

for _, url in ipairs(scripts) do
    task.spawn(function()
        loadScript(url)
    end)
end

print("Multi-Loader ejecutado")